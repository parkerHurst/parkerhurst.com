---
import type { PortfolioCollection, SportKey } from '../data/portfolio';
import SidebarNav from './SidebarNav.astro';
import PhotoViewer from './PhotoViewer.astro';
import viewerScript from '../scripts/portfolio-viewer.js?url';

interface Props {
	portfolio: PortfolioCollection;
}

const { portfolio } = Astro.props;
const initialSport = portfolio.sports[0]?.key;
const counts = Object.fromEntries(
	portfolio.sports.map((sport) => [
		sport.key,
		portfolio.photos.filter((photo) => photo.sport === sport.key).length,
	]),
) as Record<SportKey, number>;
const initialTotal = initialSport ? counts[initialSport] : 0;
const initialCounter = `${String(initialTotal ? 1 : 0).padStart(2, '0')} / ${String(initialTotal).padStart(2, '0')}`;
---

<div class="portfolio-shell" data-portfolio-root data-initial-sport={initialSport}>
	<SidebarNav
		sports={portfolio.sports}
		counts={counts}
		initialSport={initialSport}
		initialCounter={initialCounter}
	/>
	<PhotoViewer sports={portfolio.sports} photos={portfolio.photos} initialSport={initialSport} />
</div>

<dialog
	class="mobile-notice"
	data-mobile-notice
	aria-labelledby="mobile-notice-title"
	aria-describedby="mobile-notice-description"
>
	<div class="mobile-notice-copy">
		<h1 id="mobile-notice-title">This page is best viewed on a wider screen</h1>
		<p id="mobile-notice-description">Come back on a desktop, laptop, or tablet</p>
	</div>
	<button type="button" data-mobile-notice-dismiss>Continue anyways</button>
</dialog>

<p class="copyright-notice">© 2026 Parker Hurst Photo LLC</p>

<script type="module" src={viewerScript}></script>
