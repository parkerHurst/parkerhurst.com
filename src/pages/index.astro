---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioShell from '../components/PortfolioShell.astro';
import { portfolioCollection } from '../data/portfolio';

const pageTitle = 'Parker Hurst';
const pageDescription =
	'Sports photography portfolio for Parker Hurst';
const ogImage = portfolioCollection.photos[0]?.src;
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
	<PortfolioShell portfolio={portfolioCollection} />
</BaseLayout>
